<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="regression test suite" verbose="1" parallel="tests">

    <test name="chrome" parallel="classes">
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="login.LoginTests">
                <methods>
                    <include name="t3"></include>
                </methods>
            </class>

            <class name="login.LoginTests2"></class>
        </classes>
    </test>


    <test name="edge" parallel="classes" >
        <parameter name="browser" value="edge"></parameter>

        <classes>
            <class name="login.LoginTests"></class>

            <class name="login.LoginTests2">
                <methods>
                    <include name="t3"></include>
                </methods>
            </class>

        </classes>
    </test>
</suite>